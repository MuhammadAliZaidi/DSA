#include<iostream>
using namespace std;
struct Node{
    int data;
    struct Node* next;
};
struct Node* first=nullptr;
void create(int A[],int n){
    Node * t,*last;
    first=new Node;
    first->data=A[0];
    first->next=nullptr;
    last=first;
    
    for(int i=1;i<n;i++){
        t=new Node;
        t->data=A[i];
        t->next=nullptr;
        last->next=t;
        last=t;
        
    }
}
void display(struct Node* p){
    while(p!=nullptr){
        cout<<p->data<<" ";
        p=p->next;
    }
}
int Recursivecount(struct Node* p){
    if(p==0){
        return 0;
    }
    else
        return 1+Recursivecount(p->next);
}

int main() {
    int A[] = {3, 8, 6};
    create(A, 3);
    display(first);
    cout<<"\nThe count is "<<Recursivecount(first)<<endl;
    return 0;
}
