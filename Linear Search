#include<iostream>
using namespace std;
struct Node{
    int data;
    Node* next;
};
Node* first=NULL;
void create(int A[],int n){
    Node *t,*last;
    first=new Node;
    first->data=A[0];
    first->next=NULL;
    last=first;
    for(int i=1;i<n;i++){
        t=new Node;
        t->data=A[i];
        t->next=NULL;
        last->next=t;
        last=t;
    }
}
Node * Search(Node* p,int key){
    while(p!=NULL){
        if(key==p->data){
            return p;
        } p=p->next;
    } return 0;
}
void display(Node* p) {
    while(p != NULL) {
        cout << p->data << " ";
        p = p->next;
    }
}
int main() {
    int A[] = {23,6,7,11,3, 8, 6};
    create(A, 7);
    display(first);
    Node* result=Search(first,11);
    if(result!=NULL){
        cout<<"\nElement found: "<<result->data<<endl;
    }
    else{
        cout<<"Element not found "<<endl;
    }
    return 0;
}
